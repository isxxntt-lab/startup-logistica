# Copia a .env (no commitear valores reales).
# Redis NO publica puertos al host. requirepass es obligatorio.

REDIS_PASSWORD=cambia-este-secreto-logiq
GEOFENCE_RADIUS_M=500

# Token interno (Bearer). Obligatorio: sin él los servicios no arrancan.
# Genera uno: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Puerto del gateway nginx en el host (los tres servicios son expose-only).
GATEWAY_PORT=8080

# Solo si arrancas un servicio fuera de compose (necesitarías publicar Redis):
# REDIS_URL=redis://:cambia-este-secreto-logiq@127.0.0.1:6379
# PORT=3000
