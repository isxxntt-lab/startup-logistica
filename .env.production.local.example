# SOLO máquina local (HTTPS con tls internal). Copiar a .env.production.local.
# No commitear .env.production.local. Estos valores son dummy, no secretos reales.
# Uso: deploy/LOCAL_HTTPS.md

NODE_ENV=production
PORT=3000

SITE_TRACKING=localhost
SITE_API=api.localhost
PUBLIC_WEB_URL=https://localhost
API_PUBLIC_URL=https://api.localhost
ACME_EMAIL=local@localhost

VITE_API_URL=https://api.localhost
CORS_ORIGIN=https://localhost

POSTGRES_USER=rutacerca
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=startup_logistica
DATABASE_URL=postgres://rutacerca:local-dev-only-change-me@postgres:5432/startup_logistica

REDIS_PASSWORD=local-dev-only-change-me
REDIS_URL=redis://:local-dev-only-change-me@redis:6379

JWT_MASTER_SECRET=local-dev-only-jwt-master-secret-32b
OPS_TOKEN=local-dev-only-ops
OPS_CHECKS_INTERVAL_MS=120000
OPS_CLIENT_RESPONSE_DELAY_MINUTES=20

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
META_APP_SECRET=
META_VERIFY_TOKEN=
NOTIFICATION_RETRY_POLL_MS=30000
