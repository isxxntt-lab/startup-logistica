# Plantilla para smoke local del stack prod (HTTPS interno).
# Copiar a .env.production (gitignore) y NO commitear secretos reales.
#
#   cp .env.production.local.example .env.production
#   docker compose -f docker-compose.prod.yml -f docker-compose.prod.local.yml \
#     --env-file .env.production up -d --build
#
# Ver deploy/LOCAL_HTTPS.md. Para ACME/dominios reales usa .env.production.example.

NODE_ENV=production
PORT=3000

SITE_TRACKING=localhost
SITE_API=api.localhost
PUBLIC_WEB_URL=https://localhost
API_PUBLIC_URL=https://api.localhost
ACME_EMAIL=ops@localhost

# SPA: origen de la API en el build. api.localhost resuelve a 127.0.0.1 (RFC 6761).
VITE_API_URL=https://api.localhost
CORS_ORIGIN=https://localhost

POSTGRES_USER=rutacerca
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=startup_logistica
DATABASE_URL=postgres://rutacerca:CAMBIA_ESTO@postgres:5432/startup_logistica

REDIS_PASSWORD=CAMBIA_ESTO
REDIS_URL=redis://:CAMBIA_ESTO@redis:6379

JWT_MASTER_SECRET=CAMBIA_ESTO_32_BYTES_ALEATORIOS

OPS_TOKEN=CAMBIA_ESTO
OPS_CHECKS_INTERVAL_MS=120000
OPS_CLIENT_RESPONSE_DELAY_MINUTES=20

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
META_APP_SECRET=
META_VERIFY_TOKEN=
NOTIFICATION_RETRY_POLL_MS=30000
