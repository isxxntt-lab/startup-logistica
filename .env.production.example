# Producción. Copiar a /etc/rutacerca.env (modo 600) o usar:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# No commitear este archivo con secretos reales.

NODE_ENV=production
PORT=3000

# Dominios (Caddy + enlaces del destinatario)
SITE_TRACKING=seguimiento.rutacerca.es
SITE_API=api.rutacerca.es
PUBLIC_WEB_URL=https://seguimiento.rutacerca.es
API_PUBLIC_URL=https://api.rutacerca.es

# Let's Encrypt (Caddy bloque global `email`). Avisos de caducidad del cert.
ACME_EMAIL=ops@rutacerca.es

# SPA: URL absoluta de la API (build-arg). Vacío si unificas origen en Caddy.
VITE_API_URL=https://api.rutacerca.es
CORS_ORIGIN=https://seguimiento.rutacerca.es

# PostGIS (solo red interna; no hay ports públicos)
POSTGRES_USER=rutacerca
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=startup_logistica
DATABASE_URL=postgres://rutacerca:CAMBIA_ESTO@postgres:5432/startup_logistica
# Backup/restore: ver deploy/BACKUP_RESTORE.md
#   ./scripts/backup-postgres.sh
#   PLAN=1 ./scripts/restore-postgres.sh <dump.dump>
#   CONFIRM=yes ./scripts/restore-postgres.sh <dump.dump>
# BACKUP_DIR=./backups/postgres
# BACKUP_KEEP_DAYS=14

# Redis
REDIS_PASSWORD=CAMBIA_ESTO
REDIS_URL=redis://:CAMBIA_ESTO@redis:6379

JWT_MASTER_SECRET=CAMBIA_ESTO_32_BYTES_ALEATORIOS

# Ops (cron: header x-ops-token)
OPS_TOKEN=CAMBIA_ESTO
OPS_CHECKS_INTERVAL_MS=120000
OPS_CLIENT_RESPONSE_DELAY_MINUTES=20

# Mensajería (vacío = dry-run)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
META_APP_SECRET=
META_VERIFY_TOKEN=
