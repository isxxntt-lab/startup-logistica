{
  "name": "@startup-logistica/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "start": "tsx --env-file ../../.env src/index.ts",
    "start:prod": "tsx src/index.ts",
    "demo:geocerca": "tsx --env-file ../../.env src/scripts/demo-geocerca.ts",
    "ops:checks": "tsx --env-file ../../.env src/scripts/run-ops-checks.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "tsx --env-file ../../.env --test src/tracking-gate.test.ts src/lib/ops/ops.test.ts src/rate-limit.test.ts src/ws/auth.test.ts src/prod-smoke.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@startup-logistica/shared": "workspace:*",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
