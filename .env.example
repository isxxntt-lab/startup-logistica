NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://logistica:logistica@localhost:5432/startup_logistica
REDIS_URL=redis://localhost:6379

# Postgres: TLS y tuning del pool (opcionales)
# DATABASE_SSL=true                     # o usa ?sslmode=require en DATABASE_URL (Postgres gestionado)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true # por defecto false (acepta certificados de proveedor)
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECTION_TIMEOUT_MS=10000
JWT_MASTER_SECRET=cambia-este-secreto-en-produccion
PUBLIC_WEB_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Twilio (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Meta (si más adelante dejas Twilio)
META_APP_SECRET=
META_VERIFY_TOKEN=

# MapTiler (tiles MapLibre en la web del cliente)
VITE_MAPTILER_KEY=
VITE_API_URL=http://localhost:3000

# Cloudflare R2 (prueba de ausencia)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pruebas-ausencia

# FCM
FCM_SERVER_KEY=

# Ops / monitoreo
OPS_TOKEN=
OPS_CHECKS_INTERVAL_MS=120000
OPS_CLIENT_RESPONSE_DELAY_MINUTES=20
