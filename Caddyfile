# Pasarela TLS de ejemplo (Caddy 2).
# Hosts separados: SPA de seguimiento + API/WebSocket/webhooks.
# Sustituye los dominios con SITE_TRACKING y SITE_API (ver .env.production.example).
# ACME_EMAIL: avisos de caducidad de Let's Encrypt (bloque global).
#
# Variante un solo host (descomenta el bloque final y comenta los dos primeros):
#   PUBLIC_WEB_URL=https://app.rutacerca.es
#   VITE_API_URL=   (vacío: el SPA llama a /api en el mismo origen)

{
	email {$ACME_EMAIL:ops@rutacerca.es}
}

{$SITE_TRACKING:seguimiento.rutacerca.es} {
	encode gzip
	reverse_proxy web:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$SITE_API:api.rutacerca.es} {
	encode gzip
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

